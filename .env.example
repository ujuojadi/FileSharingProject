# Example environment variables for local development
# Copy this to `.env` and fill in the real values (DO NOT commit `.env`)

# Secret used to sign JWT tokens (preferred var name: NOTESHARE_JWT_SECRET_KEY)
# Example: NOTESHARE_JWT_SECRET_KEY=change_this_to_a_secure_random_value

# Access token expiry (minutes)
# Example: NOTESHARE_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database configuration
# Preferred: set a full SQLAlchemy async URL using NOTESHARE_DATABASE_URL
# Example SQLite (recommended for local dev):
# NOTESHARE_DATABASE_URL=sqlite+aiosqlite:///./dev.db
# Example MySQL / MariaDB (async driver aiomysql). To make MySQL the default,
# you can uncomment and edit the following line in your `.env` file.
NOTESHARE_DATABASE_URL=mysql+aiomysql://fileshare_user:your_db_password_here@127.0.0.1:3306/fileshare_db?charset=utf8mb4

# Backwards-compat: you can still use legacy DB_* variables (example below);
# the app will construct a NOTESHARE_DATABASE_URL from them if provided.
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=fileshare_db
# DB_USER=fileshare_user
# DB_PASSWORD=your_db_password_here

# CORS allowed origins for backend (comma-separated or a single origin)
# NOTESHARE_CORS_ALLOW_ORIGINS=http://localhost:3000

# Frontend: base URL of backend API (used by React app)
# REACT_APP_API_URL=http://localhost:8000
