## Example PostgreSQL URL (recommended for production/free deployment platforms)
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
NOTESHARE_DATABASE_URL=postgresql+asyncpg://fileshare_user:your_db_password_here@127.0.0.1:5432/fileshare_db
NOTESHARE_SECRET_KEY=your_secret_key_here
NOTESHARE_ACCESS_TOKEN_EXPIRE_MINUTES=1440
NOTESHARE_CORS_ALLOW_ORIGINS=["http://localhost:3000"]
NOTESHARE_ALLOWED_EMAIL_DOMAIN=ul.edu
